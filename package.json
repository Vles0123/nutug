{
  "name": "nutug",
  "version": "1.0.0",
  "private": true,
  "description": "Traditional Mongolian history and culture atlas",
  "license": "UNLICENSED",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "npm run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build:content && npm run build && node scripts/test.cjs",
    "test:core": "node tests/chinese-almanac-core-check.cjs",
    "check": "npm run format:check && npm test",
    "build": "node scripts/build-web.mjs",
    "build:content": "node scripts/build-content.mjs",
    "content:dev": "node scripts/build-content.mjs && node scripts/content-server.mjs",
    "content:publish": "node scripts/publish-content.mjs",
    "audit:ui-copy": "node scripts/audit-ui-copy.mjs"
  },
  "devDependencies": {
    "@internationalized/string": "3.2.10",
    "esbuild": "0.28.2",
    "jsdom": "30.1.1",
    "prettier": "3.9.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vles0123/nutug.git"
  },
  "homepage": "https://nutug.cn/",
  "dependencies": {
    "d3-force": "3.0.0",
    "lucide-react": "1.51.0",
    "motion": "14.0.0",
    "react": "19.3.0",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0"
  }
